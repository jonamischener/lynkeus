{
  "name": "lynkeus-headless",
  "version": "0.2.1",
  "description": "Run a React Native app under jest and React Native Testing Library as a host for lynkeus-agent: same protocol, no simulator.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mocks": {
      "types": "./lib/mocks/index.d.ts",
      "default": "./lib/mocks/index.js"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonamischener/lynkeus.git",
    "directory": "packages/headless"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0",
    "yoga-layout": "3.2.1"
  },
  "peerDependencies": {
    "@testing-library/react-native": "*",
    "lynkeus-agent": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "lynkeus-agent": "workspace:^",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "lynkeus-agent-source"
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|yoga-layout)/)"
    ]
  },
  "homepage": "https://github.com/jonamischener/lynkeus#readme"
}
