{
  "name": "lynkeus-agent",
  "version": "0.2.1",
  "description": "In-app QA agent for React Native: read the screen, drive the app and assert, in milliseconds, from any test runner.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "lynkeus-agent-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./auto": {
      "lynkeus-agent-source": "./src/auto.ts",
      "types": "./lib/typescript/src/auto.d.ts",
      "default": "./lib/module/auto.js"
    },
    "./presentation": {
      "lynkeus-agent-source": "./src/presentation.ts",
      "types": "./lib/typescript/src/presentation.d.ts",
      "default": "./lib/module/presentation.js"
    },
    "./hosts": {
      "lynkeus-agent-source": "./src/hosts.ts",
      "types": "./lib/typescript/src/hosts.d.ts",
      "default": "./lib/module/hosts.js"
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc",
    "test": "jest",
    "clean": "del-cli lib"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "qa",
    "testing",
    "e2e",
    "automation",
    "agent",
    "fabric",
    "turbomodule"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonamischener/lynkeus.git",
    "directory": "packages/agent"
  },
  "author": "Jonathan Mischener <jmischener@gmail.com> (https://github.com/jonamischener)",
  "license": "MIT",
  "homepage": "https://github.com/jonamischener/lynkeus#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "lynkeus-protocol": "workspace:^",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.1",
    "test-renderer": "^1.2.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "LynkeusSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.lynkeus"
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "lynkeus-agent-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "jest"
    ],
    "version": "0.63.1"
  }
}
